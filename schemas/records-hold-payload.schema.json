{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizard-agent-layer.local/schemas/records-hold-payload.schema.json",
  "title": "authenticated records hold register payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "policy_id", "policy_sha256", "target_root_hash", "effective_at", "expires_at", "holds"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "records-hold-register" },
    "policy_id": { "$ref": "#/$defs/id" },
    "policy_sha256": { "$ref": "#/$defs/hash" },
    "target_root_hash": { "$ref": "#/$defs/hash" },
    "effective_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hold_id", "scope", "artifact_classes", "record_ids", "owner_id", "reason_code", "active_from", "expires_at"],
        "properties": {
          "hold_id": { "$ref": "#/$defs/id" },
          "scope": { "enum": ["all", "classes", "records"] },
          "artifact_classes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/artifactClass" } },
          "record_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^rec_[a-f0-9]{32}$" } },
          "owner_id": { "$ref": "#/$defs/id" },
          "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
          "active_from": { "type": "string", "format": "date-time" },
          "expires_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
        },
        "allOf": [
          { "if": { "properties": { "scope": { "const": "all" } }, "required": ["scope"] }, "then": { "properties": { "artifact_classes": { "type": "array", "maxItems": 0 }, "record_ids": { "type": "array", "maxItems": 0 } } } },
          { "if": { "properties": { "scope": { "const": "classes" } }, "required": ["scope"] }, "then": { "properties": { "artifact_classes": { "type": "array", "minItems": 1 }, "record_ids": { "type": "array", "maxItems": 0 } } } },
          { "if": { "properties": { "scope": { "const": "records" } }, "required": ["scope"] }, "then": { "properties": { "artifact_classes": { "type": "array", "maxItems": 0 }, "record_ids": { "type": "array", "minItems": 1 } } } }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactClass": { "enum": ["memory", "routing-decision", "routing-execution", "update-history", "loop-events", "loop-run-log"] }
  }
}
