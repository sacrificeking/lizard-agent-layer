{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizard-agent-layer.dev/schemas/trust-store.schema.json",
  "title": "External lizard trust store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization_id", "keys", "revoked_key_ids", "revoked_envelope_ids", "revoked_nonces"],
  "properties": {
    "schema_version": { "const": 1 },
    "organization_id": { "$ref": "#/$defs/id" },
    "keys": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issuer_id", "key_id", "principal_id", "roles", "algorithm", "status", "not_before", "not_after", "public_jwk"],
        "properties": {
          "issuer_id": { "$ref": "#/$defs/id" }, "key_id": { "$ref": "#/$defs/id" }, "principal_id": { "$ref": "#/$defs/id" },
          "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "algorithm": { "const": "RS256" }, "status": { "enum": ["active", "disabled"] },
          "not_before": { "type": "string", "format": "date-time" }, "not_after": { "type": "string", "format": "date-time" },
          "public_jwk": {
            "type": "object", "additionalProperties": false, "required": ["kty", "n", "e"],
            "properties": { "kty": { "const": "RSA" }, "n": { "$ref": "#/$defs/base64url" }, "e": { "$ref": "#/$defs/base64url" } }
          }
        }
      }
    },
    "revoked_key_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "revoked_envelope_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{32}$" } },
    "revoked_nonces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
