{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizard-agent-layer.local/schemas/verification-command-plan.schema.json",
  "title": "lizard-agent-layer constrained verification command plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "plan_id", "created_at", "expires_at", "runner_id", "worktree_root", "worktree_identity_sha256", "executable", "commands", "restrictions"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "verification-command-plan" },
    "plan_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "runner_id": { "const": "lizard-constrained-verifier-v1" },
    "worktree_root": { "type": "string", "minLength": 1 },
    "worktree_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "const": "git" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "timeout_seconds", "expected_exit_codes"],
        "properties": {
          "command_id": { "enum": ["git-head", "git-missing-ref-probe"] },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
          "expected_exit_codes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 1, "maxItems": 8, "uniqueItems": true }
        }
      }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "network", "working_directory", "environment", "child_processes", "interactive", "output"],
      "properties": {
        "shell": { "const": false },
        "network": { "const": "denied-by-command-allowlist" },
        "working_directory": { "const": "worktree-root-only" },
        "environment": { "const": "sanitized-minimal" },
        "child_processes": { "const": "allowlisted-executable-only" },
        "interactive": { "const": false },
        "output": { "const": "hash-and-size-only" }
      }
    }
  }
}
