{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizard-agent-layer.dev/schemas/worktree-lifecycle.schema.json",
  "title": "lizard-agent-layer worktree lifecycle envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "envelope_id", "payload_kind", "issuer_id", "key_id", "principal_id", "issued_at", "expires_at", "purpose", "subject", "nonce", "challenge_sha256", "binding_sha256", "approval_ref", "payload_sha256", "signature_algorithm", "payload", "signature"],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact_kind": { "const": "signed-evidence" },
    "envelope_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "payload_kind": { "const": "worktree-lifecycle" },
    "issuer_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "key_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "principal_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "purpose": { "const": "worktree-registration" },
    "subject": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "nonce": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "challenge_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_ref": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature_algorithm": { "const": "RS256" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "status", "target_root", "git_common_dir", "branch", "base_sha", "worktree_root", "auto_merge"],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "status": { "enum": ["PREVIEW", "CREATED", "STOP"] },
        "created_at": { "type": "string", "format": "date-time" },
        "target_root": { "type": "string", "minLength": 1 },
        "target_git_root": { "type": ["string", "null"] },
        "git_common_dir": { "type": ["string", "null"] },
        "item_id": { "type": "string" },
        "branch": { "type": "string", "minLength": 1 },
        "observed_branch": { "type": ["string", "null"] },
        "base_ref": { "type": "string" },
        "base_sha": { "type": ["string", "null"] },
        "observed_head_sha": { "type": ["string", "null"] },
        "worktree_root": { "type": "string", "minLength": 1 },
        "worktree_common_dir": { "type": ["string", "null"] },
        "mutation_origin": { "enum": ["none", "layer", "external-registered"] },
        "human_approved": { "type": "boolean" },
        "auto_merge": { "const": false }
      }
    }
  }
}
