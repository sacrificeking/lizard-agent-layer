{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizard-agent-layer.dev/schemas/verifier-evidence.schema.json",
  "title": "lizard-agent-layer verifier evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "envelope_id", "payload_kind", "issuer_id", "key_id", "principal_id", "issued_at", "expires_at", "purpose", "subject", "nonce", "challenge_sha256", "binding_sha256", "approval_ref", "payload_sha256", "signature_algorithm", "payload", "signature"],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact_kind": { "const": "signed-evidence" },
    "envelope_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "payload_kind": { "const": "verifier-evidence" },
    "issuer_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "key_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "principal_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "purpose": { "const": "loop-completion" },
    "subject": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "nonce": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "challenge_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_ref": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]{0,127}$" },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature_algorithm": { "const": "RS256" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "payload": {
      "type": "object",
      "required": ["operation_id", "lifecycle_path", "lifecycle_hash", "requested_status", "effective_status", "verifier", "implementer", "authenticated_implementer", "verified_at", "git_state_hash", "verification_plan_id", "verification_plan_sha256", "verification_runner_id", "commands", "evidence_files", "auto_merge", "human_merge_review_required"],
      "properties": {
        "operation_id": { "type": ["string", "null"] },
        "lifecycle_path": { "type": ["string", "null"] },
        "lifecycle_hash": { "type": ["string", "null"] },
        "requested_status": { "enum": ["NEEDS_REVIEW", "PASS", "WARN", "FAIL"] },
        "effective_status": { "enum": ["NEEDS_REVIEW", "PASS", "WARN", "FAIL", "INVALID"] },
        "verifier": { "type": ["string", "null"] },
        "implementer": { "type": ["string", "null"] },
        "authenticated_implementer": { "type": ["string", "null"] },
        "verified_at": { "type": "string", "format": "date-time" },
        "head_sha": { "type": ["string", "null"] },
        "git_state_hash": { "type": ["string", "null"] },
        "verification_plan_id": { "type": ["string", "null"], "pattern": "^[a-f0-9]{32}$" },
        "verification_plan_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "verification_runner_id": { "type": ["string", "null"], "enum": ["lizard-constrained-verifier-v1", null] },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_id", "started_at", "completed_at", "exit_code", "expected_exit_codes", "timed_out", "output_sha256", "output_bytes"],
            "properties": {
              "command_id": { "enum": ["git-head", "git-missing-ref-probe"] },
              "started_at": { "type": "string", "format": "date-time" },
              "completed_at": { "type": "string", "format": "date-time" },
              "exit_code": { "type": "integer" },
              "expected_exit_codes": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "uniqueItems": true },
              "timed_out": { "type": "boolean" },
              "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "output_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "evidence_files": { "type": "array" },
        "auto_merge": { "const": false },
        "human_merge_review_required": { "const": true }
      }
    }
  }
}
