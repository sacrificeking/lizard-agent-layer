{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizard-agent-layer.local/schemas/records-export.schema.json",
  "title": "records export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "export_id", "policy_id", "policy_sha256", "target_root_hash", "as_of", "sensitivity", "purpose", "audience", "content_policy", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "records-export" },
    "export_id": { "$ref": "#/$defs/id" },
    "policy_id": { "$ref": "#/$defs/id" },
    "policy_sha256": { "$ref": "#/$defs/hash" },
    "target_root_hash": { "$ref": "#/$defs/hash" },
    "as_of": { "type": "string", "format": "date-time" },
    "sensitivity": { "const": "potentially-sensitive" },
    "purpose": { "const": "records-lifecycle-export" },
    "audience": { "type": "array", "const": ["authorized-records-operators"] },
    "content_policy": { "const": "exact-selected-record-bytes" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "artifact_class", "path", "content_sha256", "file"],
        "properties": {
          "record_id": { "$ref": "#/$defs/recordId" },
          "artifact_class": { "$ref": "#/$defs/artifactClass" },
          "path": { "$ref": "#/$defs/relativePath" },
          "content_sha256": { "$ref": "#/$defs/hash" },
          "file": { "type": "string", "pattern": "^rec_[a-f0-9]{32}\\.bin$" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recordId": { "type": "string", "pattern": "^rec_[a-f0-9]{32}$" },
    "artifactClass": { "enum": ["memory", "routing-decision", "routing-execution", "update-history", "loop-events", "loop-run-log"] },
    "relativePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\u0000-\\u001f]+$" }
  }
}
