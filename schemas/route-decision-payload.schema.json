{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizard-agent-layer.local/schemas/route-decision-payload.schema.json",
  "title": "lizard-agent-layer route decision payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "receipt_id", "router_id", "request_sha256", "policy_sha256", "runtime_source_sha256", "inventory_sha256", "trust_binding_sha256", "created_at", "policy", "model_mode", "runtime_executor", "runtime_attestation", "runtime_configuration_fingerprint", "model_switch_required", "phase", "task_class", "risk_level", "data_class", "decision", "sensitivity", "purpose", "audience", "retention_class", "content_policy", "route_id", "requested_roles", "selected_role", "recommended_model", "recommended_provider", "selection_capability", "effort", "reasoning_setting", "cost_tier", "verification_mode", "fallback_used", "fallback_reason", "required_capabilities", "signals", "reason_codes", "reasons", "raw_prompt_stored", "redaction"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "route-decision" },
    "receipt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "router_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,127}$" },
    "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inventory_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trust_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "policy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "model_mode": { "enum": ["inherit-current", "inventory-routing"] },
    "runtime_executor": { "type": ["string", "null"] },
    "runtime_attestation": { "enum": ["unknown", "observed", "attested"] },
    "runtime_configuration_fingerprint": { "type": ["string", "null"], "maxLength": 200 },
    "model_switch_required": { "const": false },
    "phase": { "enum": ["strategy", "execution", "verification"] },
    "task_class": { "type": "string", "minLength": 1 },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "data_class": { "enum": ["public", "internal-code", "internal-docs", "confidential", "regulated", "secrets"] },
    "decision": { "enum": ["route", "block", "human-review"] },
    "sensitivity": { "const": "metadata-only" },
    "purpose": { "const": "route-decision-audit" },
    "audience": { "type": "array", "items": { "enum": ["operators", "auditors"] }, "minItems": 1, "uniqueItems": true },
    "retention_class": { "const": "organization-policy-required" },
    "content_policy": { "const": "identifiers-only" },
    "route_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,62}$" },
    "requested_roles": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,62}$" }, "uniqueItems": true },
    "selected_role": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,62}$" },
    "recommended_model": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$" },
    "recommended_provider": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$" },
    "selection_capability": { "type": ["string", "null"], "enum": ["subagent", "per-call", null] },
    "effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "reasoning_setting": { "type": ["string", "null"] },
    "cost_tier": { "type": ["string", "null"], "enum": ["local", "budget", "balanced", "premium", "frontier", null] },
    "verification_mode": { "enum": ["self-review", "independent-model-preferred", "human-review", "not-applicable"] },
    "fallback_used": { "type": "boolean" },
    "fallback_reason": { "type": ["string", "null"] },
    "required_capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,62}$" }, "uniqueItems": true },
    "signals": { "type": "array", "items": { "enum": ["uncertain-ownership", "unapproved-scope-expansion", "security-sensitive", "regulated-data", "plan-deviation", "repeated-verification-failure", "ambiguous-requirements"] }, "uniqueItems": true },
    "reason_codes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }, "minItems": 1, "uniqueItems": true },
    "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "raw_prompt_stored": { "const": false },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fields"],
      "properties": {
        "status": { "enum": ["not-required", "applied"] },
        "fields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "model_mode": { "const": "inherit-current" } }, "required": ["model_mode"] },
      "then": {
        "properties": {
          "runtime_executor": { "const": null },
          "runtime_attestation": { "const": "unknown" },
          "runtime_configuration_fingerprint": { "const": null },
          "recommended_model": { "const": null },
          "recommended_provider": { "const": null },
          "selection_capability": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "model_mode": { "const": "inventory-routing" }, "decision": { "const": "route" } },
        "required": ["model_mode", "decision"]
      },
      "then": {
        "properties": {
          "runtime_executor": { "type": "string", "minLength": 1 },
          "runtime_attestation": { "enum": ["observed", "attested"] },
          "runtime_configuration_fingerprint": { "type": "string", "minLength": 1 },
          "recommended_model": { "type": "string", "minLength": 1 },
          "recommended_provider": { "type": "string", "minLength": 1 },
          "selection_capability": { "enum": ["subagent", "per-call"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "redaction": {
            "type": "object",
            "properties": { "status": { "const": "not-required" } },
            "required": ["status"]
          }
        },
        "required": ["redaction"]
      },
      "then": {
        "properties": {
          "redaction": { "type": "object", "properties": { "fields": { "type": "array", "maxItems": 0 } } }
        }
      },
      "else": {
        "properties": {
          "redaction": { "type": "object", "properties": { "fields": { "type": "array", "minItems": 1 } } }
        }
      }
    }
  ]
}
